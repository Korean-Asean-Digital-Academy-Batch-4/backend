# Salin menjadi .env untuk pengembangan lokal, lalu isi nilainya.
#
#   cp .env.example .env
#
# Dibaca Node sendiri lewat --env-file-if-exists pada skrip `dev`, `start`,
# `db:migrate`, `db:siapkan-role`, `admin:create`, dan `seed:admin` — tanpa
# dependensi tambahan. `docker compose` tidak memakainya; nilainya diberikan
# langsung pada docker-compose.yml.
#
# .env TIDAK PERNAH masuk repositori dan tidak pernah dibangun ke dalam image
# — Techstack.md sec 7.

PORT=8080
# Di luar Lambda pool boleh lebih dari satu — ARCHITECTURE.md Pasal 13.
DB_POOL_MAX=10

# --- Tiga koneksi basis data - ARCHITECTURE.md Pasal 8 ----------------------
#
# Ketiganya menunjuk basis data yang SAMA dengan role yang BERBEDA. Role-nya
# sudah dibuat migrasi 0009; kata sandinya Anda yang menetapkan, karena migrasi
# disimpan di git dan tidak boleh memuat rahasia (CK-S-09).
#
# Sesudah mengisi ketiganya:
#
#   npm run db:migrate        # menerapkan skema, memakai baris MIGRASI
#   npm run db:siapkan-role   # memasang kedua kata sandi di bawah ke PostgreSQL
#
# Kata sandi lokal bukan rahasia sungguhan — kontainernya mati bersama proses.
# Yang penting pemisahan rolenya nyata, sehingga AC-20 terbukti pada aplikasi
# yang sungguhan dijalankan, bukan hanya pada koneksi tes.

# --- Pemilihan lingkungan ---------------------------------------------------
#
# lokal | aws. Menentukan dari mana rahasia dibaca dan di mana berkas rapor
# disimpan (ARCHITECTURE.md Pasal 13, src/entry/lingkungan.ts). Image-nya sama
# persis pada keduanya; yang berbeda hanya adapter yang dipilih saat menyala.
#
# Pada `aws`, seluruh baris DATABASE_URL* dan ELICE_API_KEY di bawah TIDAK
# dipakai - nilainya datang dari Secrets Manager dan SSM Parameter Store, dan
# variabel yang menggantikannya adalah AWS_REGION, DB_INANG, DB_NAMA,
# RAHASIA_APP_RW, RAHASIA_APP_RO, RAHASIA_OWNER, PARAMETER_KUNCI_AI, dan
# BUCKET_RAPOR. Kedelapannya disetel Terraform, bukan berkas ini.
LINGKUNGAN=lokal

# app_rw - seluruh jalur tulis aplikasi
DATABASE_URL=postgres://app_rw:lokal-rw@localhost:5432/edutrack
# app_ro - jalur AI. Tanpa hak tulis, dan tanpa hak baca tabel pengguna
DATABASE_URL_RO=postgres://app_ro:lokal-ro@localhost:5432/edutrack
# edutrack_owner - HANYA untuk migrasi. Tidak pernah dibaca proses yang
# melayani request; di AWS pemisahan yang sama ditegakkan IAM (DEPLOYMENT sec 9.5)
DATABASE_URL_MIGRASI=postgres://edutrack_owner:lokal@localhost:5432/edutrack

# Direktori berkas rapor bagi adapter penyimpanan lokal (ARCHITECTURE.md Pasal 11).
BERKAS_AKAR=./data/berkas

# --- Jalur AI (A8) - Techstack.md sec 6 dan payload.md ----------------------
#
# GANTI {endpoint-id} dengan id endpoint Anda - aplikasi MENOLAK menyala selama
# kurung kurawalnya masih ada. Id-nya terlihat pada halaman model Elice, dan
# bentuknya UUID, misalnya:
#
#   ELICE_BASE_URL=https://mlapi.run/6fa8f48b-1c6f-47df-9cde-58d08ec24c31
#
# Berhenti di situ. Jalur /v1/chat/completions ditambahkan adapter sendiri;
# menuliskannya di sini membuat alamatnya berlipat.
ELICE_BASE_URL=https://mlapi.run/{endpoint-id}
# Daftar nilai yang sah: GET {base}/v1/models
ELICE_MODEL=gemini-3.6-flash
# RAHASIA. Di AWS berpindah ke SSM Parameter Store bertipe SecureString.
ELICE_API_KEY=
