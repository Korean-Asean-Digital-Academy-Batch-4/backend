# Salin menjadi .env untuk pengembangan lokal, lalu isi nilainya.
#
#   cp .env.example .env
#
# Berkas .env dibaca Node sendiri lewat --env-file-if-exists pada skrip `dev`,
# `start`, `admin:create`, dan `seed:admin` — tanpa dependensi tambahan.
# `docker compose` tidak memakainya; nilainya diberikan langsung pada
# docker-compose.yml.
#
# .env TIDAK PERNAH masuk repositori (.gitignore menahannya) dan tidak pernah
# dibangun ke dalam image — Techstack.md sec 7.

DATABASE_URL=postgres://edutrack_owner:lokal@localhost:5432/edutrack
PORT=8080
# Di luar Lambda pool boleh lebih dari satu — ARCHITECTURE.md Pasal 13.
DB_POOL_MAX=10

# Direktori berkas rapor bagi adapter penyimpanan lokal (ARCHITECTURE.md Pasal 11).
BERKAS_AKAR=./data/berkas

# --- Jalur AI (A8) — Techstack.md sec 6 -------------------------------------
# Endpoint khusus Elice AI Cloud. Jalur OpenAI-compatible ditambahkan adapter,
# jadi isi HANYA sampai id endpointnya — tanpa /v1/chat/completions.
ELICE_BASE_URL=https://mlapi.run/{endpoint-id}
# Nilai yang dikirim sebagai bidang `model`. Daftarnya: GET {base}/v1/models
ELICE_MODEL=
# RAHASIA. Di AWS berpindah ke SSM Parameter Store bertipe SecureString.
ELICE_API_KEY=
